# --- Focus Mode cloud API environment -------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored; NEVER commit real values.
#
#   cp .env.example .env
#
# Node loads this file automatically via `--env-file-if-exists` in the npm
# scripts, so no dotenv dependency is needed.

# Runtime environment: development | test | production
# Anything else is rejected at startup rather than silently coerced.
NODE_ENV=development

# HTTP port the API listens on. Must be an integer between 1 and 65535.
# Not set: defaults to 4000.
PORT=4000

# MongoDB connection string.
# Example local MongoDB database:
MONGODB_URI=mongodb://localhost:27017/focus_mode

# JWT secret used by the authentication layer.
# Replace this with a strong random value in your real .env file.
JWT_SECRET=replace_with_a_secure_secret

# Frontend URL used by the cloud API.
CLIENT_URL=http://localhost:5173

# Local agent port.
AGENT_PORT=4545

# --- Add the following as later prompts land ------------------------------
# JWT_SIGNING_KEY=            # Authentication
# PAIRING_CODE_TTL_SECONDS=   # Device pairing
# COMMAND_TOKEN_TTL_SECONDS=  # Agent command authorization
# CORS_ALLOWED_ORIGIN=        # Dashboard origin allow-list