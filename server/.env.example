# --- Focus Mode cloud API environment -------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored; NEVER commit real values.
#
#   cp .env.example .env
#
# Node loads this file automatically via `--env-file-if-exists` in the npm
# scripts, so no dotenv dependency is needed.

# Runtime environment: development | test | production
# Anything else is rejected at startup rather than silently coerced.
NODE_ENV=development

# HTTP port the API listens on. Must be an integer between 1 and 65535.
# Not set: defaults to 4000.
PORT=4000

# MongoDB connection string. CONFIGURATION ONLY in this milestone — the server
# does not open a database connection yet (see PROMPTS.md, Prompt 004).
# Leave empty until the data layer lands in Prompt 005.
# A real value usually contains credentials, which is why .env is ignored and
# this variable is never logged or returned in a response.
MONGODB_URI=

# --- Add the following as later prompts land ------------------------------
# JWT_SIGNING_KEY=            # Prompt 005 (authentication)
# PAIRING_CODE_TTL_SECONDS=   # Prompt 006 (device pairing)
# COMMAND_TOKEN_TTL_SECONDS=  # Prompt 006/007 (authorising the agent)
# CORS_ALLOWED_ORIGIN=        # Prompt 009 (dashboard origin allow-list)