{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": [
          "buttonVariants",
          "badgeVariants",
          "router",
          "PROTECTED_ROUTES",
          "AgentStatusContext",
          "useAgentStatus"
        ]
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules"]
}