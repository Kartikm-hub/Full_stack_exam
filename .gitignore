# ---------------------------------------------------------------------------
# Focus Mode — Distraction Lockdown Dashboard
# Root .gitignore (covers all three workspaces: client / server / agent)
# ---------------------------------------------------------------------------

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service-account*.json

# --- Dependencies (npm / yarn / pnpm / bun) --------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# --- Build output (Vite, Webpack, Electron, electron-builder) --------------
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.netlify/
.next/
.nuxt/
.svelte-kit/
*.tsbuildinfo

# Electron specific
release/
electron-builder-output/
*.asar
*.blockmap
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
*.msi
*.app

# --- Caches ----------------------------------------------------------------
.cache/
.parcel-cache/
.turbo/
.swc/
.eslintcache
.stylelintcache
.prettiercache
.vite/
.nyc_output/
coverage/

# --- Logs & debugging ------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# --- Test / coverage artifacts ---------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
cypress/screenshots/
cypress/videos/

# --- Runtime state, sockets, locks, pid files ------------------------------
*.pid
*.pid.lock
*.seed
*.sock
*.lock
tmp/
temp/
.agent-data/
runtime/

# --- Local databases / agent persistence -----------------------------------
*.sqlite
*.sqlite3
*.db
*.ldb
dump.rdb

# --- Editors & IDEs --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS noise --------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.directory
.Trash-*
$RECYCLE.BIN/

# --- Docs build output -----------------------------------------------------
docs/_build/
docs/site/